{
  "info": {
    "name": "Popaya Notes API",
    "description": "Postman collection for verifying the Popaya Notes Management System API locally or after Vercel deployment. Change the collection variable baseUrl to your deployed Vercel URL.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "noteId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('health endpoint returns ok', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().status).to.eql('ok');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Note",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Postman verification note\",\n  \"content\": \"Created from Postman to verify the deployed API.\"\n}"
        },
        "url": "{{baseUrl}}/api/notes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('note is created', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(body.data).to.have.property('id');",
              "  pm.collectionVariables.set('noteId', body.data.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "List Notes",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/notes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('notes list returns an array', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Note By ID",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/notes/{{noteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('single note is returned', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get('noteId'));",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Search Notes",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/notes?search=verification"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('search returns matching notes', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data.length).to.be.greaterThan(0);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Update Note",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Updated Postman note\",\n  \"content\": \"Updated from Postman after deployment.\"\n}"
        },
        "url": "{{baseUrl}}/api/notes/{{noteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('note is updated', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data.title).to.eql('Updated Postman note');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Reject Empty Title",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"   \",\n  \"content\": \"This should fail validation.\"\n}"
        },
        "url": "{{baseUrl}}/api/notes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('empty title is rejected', function () {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().error).to.eql('Title must not be empty');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete Note",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/notes/{{noteId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('note is deleted', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().message).to.eql('Note deleted');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
